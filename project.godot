; Engine configuration file. Open in Godot 4.2.2.
config_version=5

[application]
config/name="Auto-Resolved"
config/description="Keep a multi-floor office running with PATCH, an overconfident new AI assistant, and carry it from job to job."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.11, 0.17, 1)

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
floor_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadButton,"button_index":11)]
}
floor_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadButton,"button_index":12)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
toggle_overview={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306), Object(InputEventJoypadButton,"button_index":4)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":80), Object(InputEventJoypadButton,"button_index":6)]
}
speed_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
speed_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
speed_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
debug_next_job={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194343)]
}

[input_devices]
pointing/emulate_mouse_from_touch=true
